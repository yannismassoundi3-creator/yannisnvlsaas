# Narixia environment variables.
#
# Copy to .env.local for local development (`cp .env.example .env.local`) and
# fill in the values. .env.local is gitignored: never commit real credentials.
# In production, set these in your host's environment settings (e.g. Vercel →
# Project → Settings → Environment Variables), not in a file.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: they
# must never hold secrets, and changing one requires a new build.

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin, without a trailing slash. Used for auth redirects, Stripe
# return URLs, canonical URLs, the sitemap and Open Graph images. When it starts
# with https://, the CSP also sends upgrade-insecure-requests.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Local stack: run `npx supabase start`, then copy API_URL, PUBLISHABLE_KEY and
# SECRET_KEY from `npx supabase status`. Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security: used for verified Stripe webhooks,
# account deletion, audit logs, rate limits and creating sample stores.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Stripe (optional until you sell; billing pages explain when it is missing)
# -----------------------------------------------------------------------------
# Use test-mode keys (sk_test_...) until the launch checklist in docs/BILLING.md
# is complete. With live keys (sk_live_...), new checkouts stay disabled until
# STRIPE_LIVE_ENABLED=true is also set.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally, printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price ID (price_...) for the Pro plan.
STRIPE_PRICE_PRO_MONTHLY=
# "true" to let Stripe Tax compute VAT at checkout. Requires Stripe Tax to be
# activated and your tax registrations added in the Stripe Dashboard.
STRIPE_AUTOMATIC_TAX=false
# Deliberate opt-in to real payments. Leave false until the Stripe account is
# verified and the launch checklist in docs/BILLING.md is complete.
STRIPE_LIVE_ENABLED=false

# Displayed Pro price, in minor units (1900 = 19.00). Must match the Stripe
# Price above; the amount actually charged always comes from Stripe.
NEXT_PUBLIC_PRO_PRICE_MINOR=1900
NEXT_PUBLIC_PRO_PRICE_CURRENCY=EUR

# -----------------------------------------------------------------------------
# Scheduled maintenance
# -----------------------------------------------------------------------------
# Bearer token for /api/cron/maintenance (Vercel Cron sends it automatically
# when the variable is named CRON_SECRET). Generate with `openssl rand -hex 32`.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Company and contact details shown on the legal, contact and pricing pages.
# Narixia never invents them: pages say "not configured yet" until you set them.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
# Defaults to NEXT_PUBLIC_SUPPORT_EMAIL.
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
# e.g. "SIREN 123 456 789, RCS Paris"
NEXT_PUBLIC_COMPANY_REGISTRATION=
NEXT_PUBLIC_COMPANY_COUNTRY=
# Published in the privacy policy's list of processors.
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_HOSTING_PROVIDER=Vercel
NEXT_PUBLIC_HOSTING_REGION=

# -----------------------------------------------------------------------------
# Development and tests only
# -----------------------------------------------------------------------------
# Direct Postgres connection for `npm run test:db` (local stack default shown).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local Mailpit inbox, read by the end-to-end tests to confirm sign-ups.
MAILPIT_URL=http://127.0.0.1:54324
# Run the end-to-end tests against an already running deployment instead of
# starting `npm run dev`.
# E2E_BASE_URL=http://localhost:3000
# Chromium binary for Playwright when it is not in the default location.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
# Credentials of the local account created by `npm run seed`.
# SEED_EMAIL=demo@narixia.test
# SEED_PASSWORD=margins2026ok
